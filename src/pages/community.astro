---
import Layout from '../layouts/Layout.astro';
import CommunityList from '../components/CommunityList.astro';
---

<Layout title="LibreFind Community Queue">
  <div class="max-w-4xl mx-auto py-12 px-4">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-white mb-2">Community Moderation Queue</h1>
      <p class="text-zinc-400">Help us review pending submissions. Upvote good apps to get them approved!</p>
    </div>
    

    <CommunityList />
  </div>
</Layout>